{
  "version": "1.0",
  "modules": {
    "system": [
      {
        "name": "PoolModule",
        "library": "libpoolmodule.so",
        "path": "./modules/system",
        "type": "SERVER",
        "autoload": true,
        "priority": 1,
        "dependencies": []
      },
      {
        "name": "DatabaseModule",
        "library": "libdatabasemodule.so",
        "path": "./modules/data",
        "type": "SERVER",
        "autoload": true,
        "priority": 2,
        "dependencies": ["PoolModule"],
        "config": {
          "mysql_host": "localhost",
          "mysql_port": 3306,
          "mysql_database": "papercrawler",
          "mysql_user": "root",
          "mysql_password": "",
          "connection_pool_size": 10,
          "max_pool_size": 50
        }
      },
      {
        "name": "CacheModule",
        "library": "libcachemodule.so",
        "path": "./modules/data",
        "type": "SERVER",
        "autoload": true,
        "priority": 3,
        "dependencies": [],
        "config": {
          "redis_host": "localhost",
          "redis_port": 6379,
          "redis_password": "",
          "redis_database": 0,
          "connection_pool_size": 5,
          "default_ttl": 3600
        }
      },
      {
        "name": "FileStorageModule",
        "library": "libfilestoragemodule.so",
        "path": "./modules/data",
        "type": "SERVER",
        "autoload": true,
        "priority": 4,
        "dependencies": [],
        "config": {
          "base_path": "./storage",
          "url_prefix": "http://localhost:8080/files",
          "max_file_size": 104857600,
          "allowed_extensions": [".pdf", ".txt", ".doc", ".docx"]
        }
      },
      {
        "name": "LoggingModule",
        "library": "liblogging.so",
        "path": "./modules/system",
        "type": "SERVER",
        "autoload": true,
        "priority": 5,
        "dependencies": [],
        "config": {
          "log_level": "INFO",
          "log_file": "./logs/papercrawler.log",
          "max_file_size": 104857600,
          "max_files": 10,
          "enable_console": true,
          "enable_structured": true
        }
      },
      {
        "name": "WatchdogModule",
        "library": "libwatchdogmodule.so",
        "path": "./modules/system",
        "type": "SERVER",
        "autoload": true,
        "priority": 6,
        "dependencies": ["PoolModule"]
      },
      {
        "name": "FilterModule",
        "library": "libfiltermodule.so",
        "path": "./modules/system",
        "type": "SERVER",
        "autoload": true,
        "priority": 7,
        "dependencies": []
      },
      {
        "name": "QueueModule",
        "library": "libqueuemodule.so",
        "path": "./modules/system",
        "type": "SERVER",
        "autoload": true,
        "priority": 8,
        "dependencies": ["PoolModule"]
      },
      {
        "name": "ResponseQueueModule",
        "library": "libresponsequeuemodule.so",
        "path": "./modules/system",
        "type": "SERVER",
        "autoload": true,
        "priority": 9,
        "dependencies": []
      },
      {
        "name": "ResponseHandlerModule",
        "library": "libresponsehandler.so",
        "path": "./modules/handler",
        "type": "SERVER",
        "autoload": true,
        "priority": 10,
        "dependencies": ["ResponseQueueModule"]
      },
      {
        "name": "MultiLevelCacheModule",
        "library": "libmultilevelcache.so",
        "path": "./modules/performance",
        "type": "SERVER",
        "autoload": true,
        "priority": 11,
        "dependencies": ["CacheModule"],
        "config": {
          "l1_size": 1000,
          "l2_size": 10000,
          "enable_lru": true
        }
      },
      {
        "name": "CompressionModule",
        "library": "libcompression.so",
        "path": "./modules/performance",
        "type": "SERVER",
        "autoload": true,
        "priority": 12,
        "dependencies": [],
        "config": {
          "algorithm": "ZSTD",
          "compression_level": 3,
          "threshold_bytes": 1024
        }
      },
      {
        "name": "AsyncTaskModule",
        "library": "libasynctask.so",
        "path": "./modules/performance",
        "type": "SERVER",
        "autoload": true,
        "priority": 13,
        "dependencies": ["PoolModule"]
      },
      {
        "name": "ZeroCopyModule",
        "library": "libzerocopy.so",
        "path": "./modules/performance",
        "type": "SERVER",
        "autoload": true,
        "priority": 14,
        "dependencies": []
      },
      {
        "name": "HttpServerModule",
        "library": "libhttpserver.so",
        "path": "./modules/network",
        "type": "SERVER",
        "autoload": true,
        "priority": 15,
        "dependencies": ["FilterModule", "QueueModule", "ResponseHandlerModule", "CompressionModule"],
        "config": {
          "port": 8080,
          "worker_threads": 8
        }
      },
      {
        "name": "MetricsModule",
        "library": "libmetrics.so",
        "path": "./modules/monitoring",
        "type": "SERVER",
        "autoload": true,
        "priority": 16,
        "dependencies": [],
        "config": {
          "enable_prometheus": true,
          "prometheus_port": 9090,
          "metrics_retention_hours": 24,
          "enable_histograms": true
        }
      },
      {
        "name": "ConfigModule",
        "library": "libconfig.so",
        "path": "./modules/system",
        "type": "SERVER",
        "autoload": true,
        "priority": 17,
        "dependencies": [],
        "config": {
          "config_dir": "./config",
          "hot_reload": true,
          "watch_interval_seconds": 30,
          "validation_schema": true
        }
      },
      {
        "name": "SecurityModule",
        "library": "libsecurity.so",
        "path": "./modules/security",
        "type": "SERVER",
        "autoload": true,
        "priority": 18,
        "dependencies": ["DatabaseModule", "CacheModule"],
        "config": {
          "jwt_secret": "your-secret-key-change-in-production",
          "jwt_expiry_hours": 24,
          "bcrypt_cost": 12
        }
      },
      {
        "name": "SessionModule",
        "library": "libsession.so",
        "path": "./modules/security",
        "type": "SERVER",
        "autoload": true,
        "priority": 19,
        "dependencies": ["CacheModule", "DatabaseModule"],
        "config": {
          "session_ttl_seconds": 3600,
          "cookie_name": "session_id",
          "cookie_domain": "localhost",
          "store_type": "redis"
        }
      },
      {
        "name": "CircuitBreakerModule",
        "library": "libcircuitbreaker.so",
        "path": "./modules/resilience",
        "type": "SERVER",
        "autoload": true,
        "priority": 20,
        "dependencies": ["MetricsModule"],
        "config": {
          "failure_threshold": 5,
          "success_threshold": 2,
          "timeout_seconds": 60,
          "half_open_requests": 3
        }
      },
      {
        "name": "EventBusModule",
        "library": "libeventbus.so",
        "path": "./modules/communication",
        "type": "SERVER",
        "autoload": true,
        "priority": 21,
        "dependencies": [],
        "config": {
          "event_queue_size": 10000,
          "enable_persistence": false,
          "enable_clustering": false
        }
      },
      {
        "name": "SchedulerModule",
        "library": "libscheduler.so",
        "path": "./modules/scheduler",
        "type": "SERVER",
        "autoload": true,
        "priority": 22,
        "dependencies": ["DatabaseModule"],
        "config": {
          "max_concurrent_jobs": 100,
          "job_retention_days": 7,
          "enable_cron": true
        }
      },
      {
        "name": "ValidationModule",
        "library": "libvalidation.so",
        "path": "./modules/validation",
        "type": "SERVER",
        "autoload": true,
        "priority": 23,
        "dependencies": [],
        "config": {
          "strict_mode": true,
          "enable_openapi_schema": true
        }
      },
      {
        "name": "WebSocketModule",
        "library": "libwebsocket.so",
        "path": "./modules/network",
        "type": "SERVER",
        "autoload": false,
        "priority": 24,
        "dependencies": ["SessionModule", "EventBusModule"],
        "config": {
          "ws_port": 8081,
          "ping_interval_seconds": 30,
          "max_connections": 10000
        }
      },
      {
        "name": "APIDocumentationModule",
        "library": "libapidoc.so",
        "path": "./modules/documentation",
        "type": "SERVER",
        "autoload": true,
        "priority": 25,
        "dependencies": ["ValidationModule"],
        "config": {
          "enable_swagger_ui": true,
          "docs_path": "/api/docs",
          "auto_generate": true
        }
      },
      {
        "name": "ProxyModule",
        "library": "libproxy.so",
        "path": "./modules/proxy",
        "type": "SERVER",
        "autoload": false,
        "priority": 26,
        "dependencies": ["HttpServerModule", "CircuitBreakerModule"],
        "config": {
          "load_balance_strategy": "round_robin",
          "health_check_interval": 10,
          "max_retries": 3
        }
      }
    ],
    "business": [
      {
        "name": "PaperApiModule",
        "library": "libpaperapi.so",
        "path": "./modules/business",
        "type": "BUSINESS",
        "autoload": true,
        "route_prefix": "/api/papers",
        "version": "1.0.0",
        "dependencies": [],
        "endpoints": {
          "GET /api/papers": "listPapers",
          "GET /api/papers/:id": "getPaper",
          "POST /api/papers": "createPaper",
          "PUT /api/papers/:id": "updatePaper",
          "DELETE /api/papers/:id": "deletePaper",
          "GET /api/papers/search": "searchPapers"
        }
      },
      {
        "name": "AuthApiModule",
        "library": "libauthapi.so",
        "path": "./modules/business",
        "type": "BUSINESS",
        "autoload": true,
        "route_prefix": "/api/auth",
        "version": "1.0.0",
        "dependencies": [],
        "endpoints": {
          "POST /api/auth/login": "login",
          "POST /api/auth/logout": "logout",
          "POST /api/auth/refresh": "refreshToken",
          "GET /api/auth/me": "getCurrentUser"
        }
      },
      {
        "name": "StatsApiModule",
        "library": "libstatsapi.so",
        "path": "./modules/business",
        "type": "BUSINESS",
        "autoload": true,
        "route_prefix": "/api/stats",
        "version": "1.0.0",
        "dependencies": [],
        "endpoints": {
          "GET /api/stats/system": "getSystemStats",
          "GET /api/stats/modules": "getModuleStats",
          "GET /api/stats/performance": "getPerformanceMetrics"
        }
      },
      {
        "name": "AiCoPilotModule",
        "library": "libaicopilot.so",
        "path": "./modules/business",
        "type": "BUSINESS",
        "autoload": true,
        "route_prefix": "/api/ai-co-pilot",
        "version": "1.0.0",
        "dependencies": ["AiApiModule", "KnowledgeGraphModule"],
        "endpoints": {
          "POST /api/ai-co-pilot/review": "generateReview",
          "GET /api/ai-co-pilot/reviews/:userId": "getReviewHistory",
          "POST /api/ai-co-pilot/literature-review/generate": "generateLiteratureReview",
          "GET /api/ai-co-pilot/literature-reviews": "getLiteratureReviews",
          "POST /api/ai-co-pilot/research-plan/generate": "generateResearchPlan",
          "GET /api/ai-co-pilot/research-plans": "getResearchPlans",
          "POST /api/ai-co-pilot/chat": "chat",
          "GET /api/ai-co-pilot/conversations": "getConversations",
          "GET /api/ai-co-pilot/recommendations": "getRecommendations",
          "GET /api/ai-co-pilot/stats": "getUsageStats"
        }
      }
    ]
  },
  "unload_policy": {
    "strategy": "graceful",
    "idle_timeout": 300,
    "force_after_seconds": 60,
    "check_dependencies": true,
    "graceful_shutdown": true
  }
}
