{
  "modulesDirectory": "modules",
  "healthCheckInterval": 30,
  "modules": [
    {
      "name": "AuthApiModule",
      "type": "BUSINESS",
      "version": "1.0.0",
      "description": "Authentication and Authorization API",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/auth",
      "libraryPath": "modules/libAuthApiModule.so",
      "loadPriority": 1,
      "endpoints": [
        "POST /api/auth/login",
        "POST /api/auth/register",
        "POST /api/auth/logout",
        "POST /api/auth/refresh",
        "GET /api/auth/me"
      ],
      "dependencies": [],
      "config": {}
    },
    {
      "name": "UserApiModule",
      "type": "BUSINESS",
      "version": "1.0.0",
      "description": "User Management API",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/users",
      "libraryPath": "modules/libUserApiModule.so",
      "loadPriority": 2,
      "endpoints": [
        "GET /api/users",
        "GET /api/users/:id",
        "POST /api/users",
        "PUT /api/users/:id",
        "DELETE /api/users/:id"
      ],
      "dependencies": [],
      "config": {}
    },
    {
      "name": "PaperApiModule",
      "type": "BUSINESS",
      "version": "1.0.0",
      "description": "Paper Management API",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/papers",
      "libraryPath": "modules/libPaperApiModule.so",
      "loadPriority": 3,
      "endpoints": [
        "GET /api/papers",
        "GET /api/papers/:id",
        "POST /api/papers",
        "PUT /api/papers/:id",
        "DELETE /api/papers/:id",
        "GET /api/papers/search",
        "GET /api/papers/favorites",
        "GET /api/papers/categories",
        "GET /api/papers/tags"
      ],
      "dependencies": [],
      "config": {}
    },
    {
      "name": "SearchApiModule",
      "type": "BUSINESS",
      "version": "1.0.0",
      "description": "Search and Filtering API",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/search",
      "libraryPath": "modules/libSearchApiModule.so",
      "loadPriority": 4,
      "endpoints": [
        "GET /api/search",
        "GET /api/search/papers",
        "GET /api/search/advanced"
      ],
      "dependencies": [],
      "config": {}
    },
    {
      "name": "StatsApiModule",
      "type": "BUSINESS",
      "version": "1.0.0",
      "description": "Statistics and Analytics API",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/stats",
      "libraryPath": "modules/libStatsApiModule.so",
      "loadPriority": 5,
      "endpoints": [
        "GET /api/stats/overview",
        "GET /api/stats/papers",
        "GET /api/stats/users",
        "GET /api/stats/crawler"
      ],
      "dependencies": [],
      "config": {}
    },
    {
      "name": "ExportApiModule",
      "type": "BUSINESS",
      "version": "1.0.0",
      "description": "Export and Download API",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/export",
      "libraryPath": "modules/libExportApiModule.so",
      "loadPriority": 6,
      "endpoints": [
        "GET /api/export/papers",
        "GET /api/export/stats",
        "POST /api/export/request"
      ],
      "dependencies": [],
      "config": {}
    },
    {
      "name": "AiApiModule",
      "type": "BUSINESS",
      "version": "1.0.0",
      "description": "AI Services API",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/ai",
      "libraryPath": "modules/libAiApiModule.so",
      "loadPriority": 7,
      "endpoints": [
        "GET /api/assistant",
        "POST /api/ai/chat",
        "GET /api/ai/review",
        "GET /api/ai/literature-review"
      ],
      "dependencies": [],
      "config": {}
    },
    {
      "name": "RecommendationApiModule",
      "type": "BUSINESS",
      "version": "1.0.0",
      "description": "Recommendation Engine API",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/recommendations",
      "libraryPath": "modules/libRecommendationApiModule.so",
      "loadPriority": 8,
      "endpoints": [
        "GET /api/recommendations",
        "GET /api/recommendations/papers",
        "GET /api/recommendations/users"
      ],
      "dependencies": [],
      "config": {}
    },
    {
      "name": "TemplateCrawlerModule",
      "type": "BUSINESS",
      "version": "1.0.0",
      "description": "Template-based Web Crawler Engine",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/crawler/templates",
      "libraryPath": "modules/libTemplateCrawlerModule.so",
      "loadPriority": 11,
      "endpoints": [
        "GET /api/crawler/templates",
        "GET /api/crawler/templates/:id",
        "POST /api/crawler/templates",
        "PUT /api/crawler/templates/:id",
        "DELETE /api/crawler/templates/:id",
        "POST /api/crawler/templates/:id/test"
      ],
      "dependencies": [],
      "config": {}
    },
    {
      "name": "CrawlerApiModule",
      "type": "BUSINESS",
      "version": "1.0.0",
      "description": "Crawler Management API",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/crawler",
      "libraryPath": "modules/libCrawlerApiModule.so",
      "loadPriority": 10,
      "endpoints": [
        "GET /api/crawler/tasks",
        "GET /api/crawler/tasks/:id",
        "POST /api/crawler/tasks",
        "DELETE /api/crawler/tasks/:id",
        "POST /api/crawler/tasks/:id/start",
        "POST /api/crawler/tasks/:id/stop",
        "GET /api/crawler/nodes",
        "GET /api/crawler/statistics"
      ],
      "dependencies": [{"module": "TemplateCrawlerModule", "minVersion": "1.0.0", "optional": false}],
      "config": {}
    },
    {
      "name": "DistributedTaskModule",
      "type": "BUSINESS",
      "version": "1.0.0",
      "description": "Distributed Task Scheduling Module",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/distributed",
      "libraryPath": "modules/libDistributedTaskModule.so",
      "loadPriority": 9,
      "endpoints": [
        "GET /api/distributed/workers",
        "GET /api/distributed/workers/:id",
        "POST /api/distributed/workers",
        "PUT /api/distributed/workers/:id",
        "DELETE /api/distributed/workers/:id",
        "GET /api/distributed/tasks",
        "POST /api/distributed/tasks/assign"
      ],
      "dependencies": [],
      "config": {}
    }
  ]
}