        "GET /api/ai/literature-review"
      ],
      "dependencies": [],
      "config": {}
    },
    {
      "name": "RecommendationApiModule",
      "type": "BUSINESS",
      "version": "1.0.0",
      "description": "Recommendation Engine API",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/recommendations",
      "libraryPath": "modules/libRecommendationApiModule.dll",
      "loadPriority": 8,
      "endpoints": [
        "GET /api/recommendations",
        "GET /api/recommendations/papers",
        "GET /api/recommendations/users"
