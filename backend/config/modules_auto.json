      "type": "BUSINESS",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/auth",
      "libraryPath": "./modules/dynamic/Release/libAuthApiModule.so",
      "loadPriority": 98,
      "endpoints": [
        "POST /api/auth/register",
        "POST /api/auth/login",
        "POST /api/auth/logout",
        "POST /api/auth/refresh",
        "GET /api/auth/verify"
      ],
      "dependencies": [],
      "config": {
        "sessionTimeout": "3600",
        "maxLoginAttempts": "5"
      }
    },
