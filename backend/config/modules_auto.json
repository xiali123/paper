{
  "modulesDirectory": "./modules/dynamic/Release",
  "healthCheckInterval": 30,
  "modules": [
    {
      "name": "AuthApi",
      "version": "1.0.0",
      "description": "Authentication and authorization API module",
      "type": "BUSINESS",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/auth",
      "libraryPath": "./modules/dynamic/Release/libAuthApiModule.dll",
      "loadPriority": 90,
      "endpoints": [
        "POST /api/auth/register",
        "POST /api/auth/login",
        "POST /api/auth/logout",
        "POST /api/auth/refresh",
        "GET /api/auth/verify"
      ],
      "dependencies": [],
      "config": {
        "sessionTimeout": "3600",
        "maxLoginAttempts": "5"
      }
    },
    {
      "name": "UserApi",
      "version": "1.0.0",
      "description": "User management API module",
      "type": "BUSINESS",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/users",
      "libraryPath": "./modules/dynamic/Release/libUserApiModule.dll",
      "loadPriority": 85,
      "endpoints": [
        "GET /api/users",
        "GET /api/users/:id",
        "POST /api/users",
        "PUT /api/users/:id",
        "DELETE /api/users/:id",
        "GET /api/users/:id/profile"
      ],
      "dependencies": [
        {
          "module": "AuthApi",
          "minVersion": "1.0.0",
          "optional": false
        }
      ]
    },
    {
      "name": "PaperApi",
      "version": "1.0.0",
      "description": "Paper management API module",
      "type": "BUSINESS",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/papers",
      "libraryPath": "./modules/dynamic/Release/libPaperApiModule.dll",
      "loadPriority": 80,
      "endpoints": [
        "GET /api/papers",
        "GET /api/papers/:id",
        "POST /api/papers",
        "PUT /api/papers/:id",
        "DELETE /api/papers/:id",
        "GET /api/papers/:id/summary",
        "POST /api/papers/:id/tags"
      ],
      "dependencies": [
        {
          "module": "AuthApi",
          "minVersion": "1.0.0",
          "optional": false
        },
        {
          "module": "UserApi",
          "minVersion": "1.0.0",
          "optional": false
        }
      ]
    },
    {
      "name": "SearchApi",
      "version": "1.0.0",
      "description": "Search and filtering API module",
      "type": "BUSINESS",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/search",
      "libraryPath": "./modules/dynamic/Release/libSearchApiModule.dll",
      "loadPriority": 75,
      "endpoints": [
        "GET /api/search/papers",
        "GET /api/search/authors",
        "GET /api/search/keywords",
        "GET /api/search/suggest"
      ],
      "dependencies": [
        {
          "module": "PaperApi",
          "minVersion": "1.0.0",
          "optional": false
        }
      ]
    },
    {
      "name": "ExportApi",
      "version": "1.0.0",
      "description": "Export and download API module",
      "type": "BUSINESS",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/export",
      "libraryPath": "./modules/dynamic/Release/libExportApiModule.dll",
      "loadPriority": 70,
      "endpoints": [
        "POST /api/export/papers",
        "POST /api/export/bibliography",
        "GET /api/export/formats"
      ],
      "dependencies": [
        {
          "module": "PaperApi",
          "minVersion": "1.0.0",
          "optional": false
        }
      ]
    },
    {
      "name": "StatsApi",
      "version": "1.0.0",
      "description": "Statistics and analytics API module",
      "type": "BUSINESS",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/stats",
      "libraryPath": "./modules/dynamic/Release/libStatsApiModule.dll",
      "loadPriority": 65,
      "endpoints": [
        "GET /api/stats/overview",
        "GET /api/stats/papers",
        "GET /api/stats/authors",
        "GET /api/stats/trends"
      ],
      "dependencies": [
        {
          "module": "PaperApi",
          "minVersion": "1.0.0",
          "optional": false
        }
      ]
    },
    {
      "name": "AiApi",
      "version": "1.0.0",
      "description": "AI-powered features API module",
      "type": "BUSINESS",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/ai",
      "libraryPath": "./modules/dynamic/Release/libAiApiModule.dll",
      "loadPriority": 60,
      "endpoints": [
        "POST /api/ai/summarize",
        "POST /api/ai/analyze",
        "POST /api/ai/recommend",
        "GET /api/ai/history"
      ],
      "dependencies": [
        {
          "module": "PaperApi",
          "minVersion": "1.0.0",
          "optional": false
        }
      ],
      "config": {
        "aiServiceEndpoint": "http://localhost:5000",
        "timeout": "30"
      }
    },
    {
      "name": "RecommendationApi",
      "version": "1.0.0",
      "description": "Recommendation engine API module",
      "type": "BUSINESS",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/recommend",
      "libraryPath": "./modules/dynamic/Release/libRecommendationApiModule.dll",
      "loadPriority": 55,
      "endpoints": [
        "GET /api/recommend/papers",
        "GET /api/recommend/authors",
        "GET /api/recommend/topics"
      ],
      "dependencies": [
        {
          "module": "PaperApi",
          "minVersion": "1.0.0",
          "optional": false
        },
        {
          "module": "AiApi",
          "minVersion": "1.0.0",
          "optional": true
        }
      ]
    },
    {
      "name": "CrawlerApi",
      "version": "1.0.0",
      "description": "Crawler system REST API and WebSocket interface",
      "type": "BUSINESS",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/crawler",
      "libraryPath": "./modules/dynamic/Release/libCrawlerApiModule.dll",
      "loadPriority": 50,
      "endpoints": [
        "POST /api/crawler/templates",
        "GET /api/crawler/templates",
        "GET /api/crawler/templates/:id",
        "PUT /api/crawler/templates/:id",
        "DELETE /api/crawler/templates/:id",
        "POST /api/crawler/templates/validate",
        "POST /api/crawler/templates/:id/test",
        "GET /api/crawler/templates/:id/export",
        "POST /api/crawler/templates/import",
        "POST /api/crawler/tasks",
        "GET /api/crawler/tasks",
        "GET /api/crawler/tasks/:id",
        "DELETE /api/crawler/tasks/:id",
        "POST /api/crawler/tasks/:id/retry",
        "GET /api/crawler/tasks/:id/logs",
        "GET /api/crawler/tasks/statistics",
        "POST /api/crawler/schedules",
        "GET /api/crawler/schedules",
        "PUT /api/crawler/schedules/:id",
        "DELETE /api/crawler/schedules/:id",
        "POST /api/crawler/schedules/:id/enable",
        "POST /api/crawler/schedules/:id/disable",
        "POST /api/crawler/schedules/:id/trigger",
        "GET /api/crawler/workers",
        "GET /api/crawler/workers/:id",
        "POST /api/crawler/workers/:id/disable",
        "GET /api/crawler/workers/:id/statistics",
        "GET /api/crawler/dashboard",
        "GET /api/crawler/statistics",
        "WS /api/crawler/ws"
      ],
      "dependencies": []
    },
    {
      "name": "LatexApi",
      "version": "1.0.0",
      "description": "LaTeX editor API with compilation and collaboration support",
      "type": "BUSINESS",
      "author": "PaperCrawler Team",
      "license": "MIT",
      "routePrefix": "/api/latex",
      "libraryPath": "./modules/libLatexApiModule.so",
      "loadPriority": 45,
      "endpoints": [
        "GET /api/latex/documents",
        "GET /api/latex/documents/:id",
        "POST /api/latex/documents",
        "PUT /api/latex/documents/:id",
        "DELETE /api/latex/documents/:id",
        "POST /api/latex/documents/:id/compile",
        "POST /api/latex/documents/:id/autosave",
        "GET /api/latex/templates",
        "GET /api/latex/templates/:id",
        "POST /api/latex/templates",
        "GET /api/latex/stats",
        "GET /api/latex/documents/:id/pdf",
        "POST /api/latex/collaboration/join",
        "POST /api/latex/collaboration/leave",
        "PUT /api/latex/collaboration/cursor",
        "POST /api/latex/collaboration/update",
        "GET /api/latex/collaboration/sessions"
      ],
      "dependencies": []
    }
  ]
}
