{
  "database": {
    "type": "sqlite",
    "host": "localhost",
    "port": 3306,
    "name": "papercrawler",
    "user": "root",
    "password": "",
    "sqlite_path": "papercrawler.db",
    "charset": "utf8mb4",
    "connection_pool_size": 10,
    "timeout": 30
  },
  "authentication": {
    "enabled": true,
    "jwtSecret": "paper-crawler-secret-key-2024-change-in-production",
    "accessTokenExpiry": 15,
    "refreshTokenExpiry": 30,
    "maxLoginAttempts": 5,
    "lockDuration": 30,
    "requireVerification": false
  },
  "server": {
    "port": 8080,
    "host": "0.0.0.0",
    "worker_threads": 4,
    "max_connections": 1000,
    "request_timeout": 60
  },
  "logging": {
    "level": "debug",
    "file": "logs/api.log",
    "max_size": "100MB",
    "max_files": 10,
    "console": true
  },
  "security": {
    "enable_cors": true,
    "cors_origin": "*",
    "cors_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "cors_headers": ["Content-Type", "Authorization"],
    "rate_limiting": {
      "enabled": true,
      "requests_per_minute": 60
    }
  },
  "features": {
    "enable_search": true,
    "enable_export": true,
    "enable_statistics": true,
    "enable_authentication": true,
    "max_export_records": 10000,
    "search_timeout": 30
  }
}
