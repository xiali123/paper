#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# LaTeX Editor Pre-commit Hook
# This hook runs quality checks before allowing commits

echo "🔍 Running pre-commit quality checks..."

# Check if we're in a Git repository
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "❌ Not in a Git repository"
    exit 1
fi

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts|tsx|vue|json)$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "✅ No JavaScript/TypeScript/Vue files to check"
    exit 0
fi

echo "📋 Checking staged files:"
echo "$STAGED_FILES" | sed 's/^/  - /'

# 1. Check for console.log statements
echo "\n🔍 Checking for console.log statements..."
if echo "$STAGED_FILES" | xargs grep -l "console\.log" >/dev/null 2>&1; then
    echo "❌ Found console.log statements in staged files:"
    echo "$STAGED_FILES" | xargs grep -l "console\.log" | sed 's/^/  - /'
    echo "\n💡 Tip: Remove console.log statements before committing"
    exit 1
fi

# 2. Run ESLint on staged files
echo "\n🔍 Running ESLint..."
if ! echo "$STAGED_FILES" | xargs npx eslint --quiet; then
    echo "❌ ESLint found errors"
    echo "\n💡 Tip: Run 'npm run lint:fix' to auto-fix issues"
    exit 1
fi

# 3. Run TypeScript check on staged files
echo "\n🔍 Running TypeScript check..."
if ! echo "$STAGED_FILES" | xargs npx tsc --noEmit --pretty; then
    echo "❌ TypeScript check failed"
    echo "\n💡 Tip: Fix TypeScript errors before committing"
    exit 1
fi

# 4. Check for large files
echo "\n🔍 Checking file sizes..."
MAX_FILE_SIZE=500000 # 500KB
while IFS= read -r file; do
    if [ -f "$file" ]; then
        file_size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null)
        if [ "$file_size" -gt "$MAX_FILE_SIZE" ]; then
            echo "❌ File too large: $file ($((file_size/1024))KB)"
            echo "\n💡 Tip: Keep files under 500KB. Consider splitting large files."
            exit 1
        fi
    fi
done << EOF
$STAGED_FILES
EOF

# 5. Check for TODO comments (warn only)
echo "\n🔍 Checking for TODO comments..."
if echo "$STAGED_FILES" | xargs grep -l "TODO\|FIXME" >/dev/null 2>&1; then
    echo "⚠️  Found TODO/FIXME comments:"
    echo "$STAGED_FILES" | xargs grep -l "TODO\|FIXME" | sed 's/^/  - /'
    echo "\n💡 Tip: Consider resolving TODO comments before committing"
fi

# 6. Run Prettier check
echo "\n🔍 Checking code formatting..."
if ! echo "$STAGED_FILES" | xargs npx prettier --check --ignore-unknown; then
    echo "❌ Code formatting issues found"
    echo "\n💡 Tip: Run 'npm run format' to fix formatting issues"
    exit 1
fi

# 7. Check commit message format
echo "\n📝 Checking commit message format..."
COMMIT_MSG_FILE="$1"
if [ -n "$COMMIT_MSG_FILE" ] && [ -f "$COMMIT_MSG_FILE" ]; then
    COMMIT_MSG=$(head -n1 "$COMMIT_MSG_FILE")

    # Check conventional commit format
    if ! echo "$COMMIT_MSG" | grep -qE '^(feat|fix|docs|style|refactor|test|chore|perf|build|ci|revert)(\(.+\))?: .{1,50}'; then
        echo "❌ Commit message doesn't follow conventional commit format"
        echo "\n📋 Expected format:"
        echo "  <type>(<scope>): <description>"
        echo "\n📝 Examples:"
        echo "  feat(editor): add LaTeX syntax highlighting"
        echo "  fix(preview): resolve math rendering issue"
        echo "  docs: update installation guide"
        echo "\n💡 Tip: Use 'npm run commit' for guided commit messages"
        exit 1
    fi
fi

# 8. Check for sensitive information
echo "\n🔍 Checking for sensitive information..."
SENSITIVE_PATTERNS="password\|secret\|token\|key\|api_key\|auth_token"
if echo "$STAGED_FILES" | xargs grep -i "$SENSITIVE_PATTERNS" >/dev/null 2>&1; then
    echo "❌ Potential sensitive information found in staged files"
    echo "\n💡 Tip: Remove sensitive information before committing"
    exit 1
fi

# 9. Check package.json changes
echo "\n🔍 Checking package.json changes..."
if echo "$STAGED_FILES" | grep -q "package\.json"; then
    echo "⚠️  package.json has been modified"
    echo "💡 Tip: Make sure to run 'npm install' and commit package-lock.json too"
fi

# 10. Final success message
echo "\n✅ All pre-commit checks passed!"
echo "📦 Ready to commit LaTeX Editor changes"

exit 0