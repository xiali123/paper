{
  "name": "papercrawler-frontend",
  "version": "1.0.0",
  "description": "PaperCrawler Vue 3 Frontend Application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest --type-check --reporter=verbose",
    "test:e2e": "cypress run",
    "test:performance": "k6 run tests/performance/script.js",
    "quality-check": "npm run lint && npm run type-check && npm run test:unit",
    "ci:validate": "npm run quality-check && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "axios": "^1.6.8",
    "chart.js": "^4.4.2",
    "date-fns": "^3.6.0",
    "dompurify": "^3.3.3",
    "element-plus": "^2.6.3",
    "katex": "^0.16.45",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "pdfjs-dist": "^3.11.174",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.3",
    "socket.io-client": "^4.8.3",
    "vue": "^3.4.21",
    "vue-chartjs": "^5.3.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.12.7",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.24.1",
    "prettier": "^3.2.5",
    "puppeteer": "^24.40.0",
    "sass": "^1.75.0",
    "typescript": "^5.4.5",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.2.8",
    "vue-tsc": "^2.0.14"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
