<template>
  <div class="latex-preview">
    <div class="preview-header">
      <h4 class="preview-title">预览</h4>
      <el-tag v-if="renderError" type="danger" size="small">渲染错误</el-tag>
      <el-tag v-if="validationWarnings.length > 0" type="warning" size="small">
        {{ validationWarnings.length }} 个警告
      </el-tag>
    </div>

    <div class="preview-content" ref="contentRef">
      <div v-if="!props.content" class="preview-empty">
        <el-empty description="输入 LaTeX 内容以预览" :image-size="60" />
      </div>
      <div v-else-if="renderError" class="preview-error">
        <el-alert type="error" :closable="false">
          <template #title>
            {{ renderError }}
          </template>
        </el-alert>
      </div>
      <div v-else-if="validationErrors.length > 0" class="preview-error">
        <el-alert type="error" :closable="false">
          <template #title>
            内容验证失败
          </template>
          <ul>
            <li v-for="error in validationErrors" :key="error">{{ error }}</li>
          </ul>
        </el-alert>
      </div>
      <div v-else v-html="renderedHtml" class="preview-rendered" @click="handleMathClick"></div>
    </div>
  </div>
</template>

<script setup lang="ts">
import { ref, watch, onMounted, onUnmounted } from 'vue'
import DOMPurify from 'dompurify'
import { performanceMonitor, checkPerformanceThreshold, PERFORMANCE_THRESHOLDS } from '@/utils/performance'
import { renderLatex } from '@/utils/workers'
import { validateLatexInput, type ValidationResult } from '@/utils/latexValidation'

interface Props {
  content: string
  theme?: 'light' | 'dark'
  scale?: number
}

const props = withDefaults(defineProps<Props>(), {
  theme: 'light',
  scale: 1.0
})

const contentRef = ref<HTMLElement>()
const renderError = ref<string | null>(null)
const renderedHtml = ref('')
const validationErrors = ref<string[]>([])
const validationWarnings = ref<string[]>([])

// 渲染 LaTeX 内容
const isRendering = ref(false)

// DOMPurify configuration for additional security
const PURIFY_CONFIG = {
  ALLOWED_TAGS: [
    'h2', 'h3', 'h4', 'h5', 'h6',
    'strong', 'em', 'u', 'b', 'i',
    'ul', 'ol', 'li',
    'div', 'span', 'p', 'br', 'hr',
    'math', 'semantics', 'mrow', 'mi', 'mn', 'mo', 'mtext', 'mspace',
    'mfrac', 'msqrt', 'mroot', 'mtable', 'mtr', 'mtd', 'mstyle',
    'munder', 'mover', 'munderover', 'msup', 'msub', 'msubsup',
    'mphantom', 'merror', 'annotation', 'annotation-xml',
    'a', 'img', 'code', 'pre'
  ],
  ALLOWED_ATTR: [
    'class', 'id', 'style',
    'title', 'alt',
    'href', 'src', 'width', 'height',
    'viewbox', 'xmlns', 'data-mathml',
    'colspan', 'rowspan',
    'aria-label', 'role',
    'data-latex', 'data-katex'
  ],
  ALLOW_DATA_ATTR: false,
  SAFE_FOR_JQUERY: true,
  SANITIZE_DOM: true,
  KEEP_CONTENT: true,
  ADD_ATTR: ['data-latex', 'data-katex'],
  FORBID_TAGS: ['script', 'style', 'iframe', 'object', 'embed', 'form', 'input', 'button'],
  FORBID_ATTR: ['onerror', 'onload', 'onclick', 'onmouseover', 'onfocus', 'onblur', 'onchange', 'onsubmit']
}

async function renderLatex() {
  const endTimer = performanceMonitor.startTimer('latex_rendering', {
    contentLength: props.content?.length || 0
  })

  isRendering.value = true

  if (import.meta.env.DEV) {
    console.log('Rendering LaTeX, content length:', props.content?.length)
  }

  // For testing, if content is empty, use a test content
  const contentToRender = props.content?.trim() || '\\section{Test}This is a test with math: $E = mc^2$'

  if (!contentToRender) {
    renderedHtml.value = ''
    renderError.value = null
    validationErrors.value = []
    validationWarnings.value = []
    return
  }

  try {
    // Step 1: Validate input BEFORE processing
    const validation: ValidationResult = validateLatexInput(contentToRender)
    validationErrors.value = validation.errors
    validationWarnings.value = validation.warnings

    if (!validation.valid) {
      renderError.value = 'Content validation failed - see errors below'
      if (import.meta.env.DEV) {
        console.error('LaTeX validation failed:', validation.errors)
      }
      endTimer()
      return
    }

    // Step 2: Use Web Worker for rendering (worker also sanitizes)
    const result = await renderLatex(contentToRender)
    let html = result.html

    // Check performance threshold
    checkPerformanceThreshold(
      'latex_rendering',
      result.processingTime,
      PERFORMANCE_THRESHOLDS.renderTime
    )

    // Step 3: Double sanitization for defense in depth
    // Even though the worker sanitizes, we sanitize again here
    renderedHtml.value = DOMPurify.sanitize(html, PURIFY_CONFIG)

    renderError.value = null

    if (import.meta.env.DEV) {
      console.log('LaTeX rendered successfully:', {
        processingTime: result.processingTime,
        contentLength: result.contentLength,
        sanitized: result.sanitized || false,
        warnings: validation.warnings.length
      })
    }

  } catch (error) {
    renderError.value = error instanceof Error ? error.message : String(error)
    console.warn('LaTeX rendering failed:', error)
  } finally {
    endTimer()
    isRendering.value = false
  }
}

// 简单的 LaTeX 结构渲染 (fallback only)
function renderLatexStructure(latex: string): string {
  let html = latex

  // 处理章节 - with escaping
  html = html.replace(/\\section\*?\{([^}]+)\}/g, (match, title) => {
    const escapedTitle = String(title).replace(/[<>]/g, '')
    return `<h2>${escapedTitle}</h2>`
  })

  html = html.replace(/\\subsection\*?\{([^}]+)\}/g, (match, title) => {
    const escapedTitle = String(title).replace(/[<>]/g, '')
    return `<h3>${escapedTitle}</h3>`
  })

  html = html.replace(/\\subsubsection\*?\{([^}]+)\}/g, (match, title) => {
    const escapedTitle = String(title).replace(/[<>]/g, '')
    return `<h4>${escapedTitle}</h4>`
  })

  // 处理文本格式 - with escaping
  html = html.replace(/\\textbf\{([^}]+)\}/g, (match, content) => {
    const escapedContent = String(content).replace(/[<>]/g, '')
    return `<strong>${escapedContent}</strong>`
  })

  html = html.replace(/\\textit\{([^}]+)\}/g, (match, content) => {
    const escapedContent = String(content).replace(/[<>]/g, '')
    return `<em>${escapedContent}</em>`
  })

  html = html.replace(/\\underline\{([^}]+)\}/g, (match, content) => {
    const escapedContent = String(content).replace(/[<>]/g, '')
    return `<u>${escapedContent}</u>`
  })

  html = html.replace(/\\emph\{([^}]+)\}/g, (match, content) => {
    const escapedContent = String(content).replace(/[<>]/g, '')
    return `<em>${escapedContent}</em>`
  })

  // 处理列表（简化）- with escaping
  html = html.replace(/\\begin\{itemize\}([\s\S]*?)\\end\{itemize\}/g, (_match, content) => {
    const items = content.split('\\item').filter((s: string) => s.trim())
    const escapedItems = items.map((item: string) => {
      const escaped = String(item).replace(/[<>]/g, '')
      return `<li>${escaped}</li>`
    }).join('')
    return `<ul>${escapedItems}</ul>`
  })

  html = html.replace(/\\begin\{enumerate\}([\s\S]*?)\\end\{enumerate\}/g, (_match, content) => {
    const items = content.split('\\item').filter((s: string) => s.trim())
    const escapedItems = items.map((item: string) => {
      const escaped = String(item).replace(/[<>]/g, '')
      return `<li>${escaped}</li>`
    }).join('')
    return `<ol>${escapedItems}</ol>`
  })

  // 处理换行
  html = html.replace(/\\\\/g, '<br>')

  // Only wrap in paragraphs if we don't already have HTML structure
  if (!html.includes('<h2>') && !html.includes('<h3>') && !html.includes('<ul>') && !html.includes('<ol>')) {
    html = html.replace(/\n\n/g, '</p><p>')
    html = '<p>' + html + '</p>'
  }

  // 清理空标签
  html = html.replace(/<p>\s*<\/p>/g, '')
  html = html.replace(/<([ou])l>\s*<\/\1l>/g, '')

  return html
}

function handleMathClick(event: MouseEvent) {
  const target = event.target as HTMLElement
  if (target.classList.contains('katex-error')) {
    console.warn('Math render error:', target.title)
  }
}

// 监听内容变化 - optimized to prevent memory leaks
const renderTimeout = ref<number | null>(null)

watch(() => props.content, (newContent, oldContent) => {
  if (import.meta.env.DEV) {
    console.log('LatexPreview content changed:', { newLength: newContent?.length, oldLength: oldContent?.length })
  }

  // Clear any pending render to prevent memory buildup
  if (renderTimeout.value) {
    clearTimeout(renderTimeout.value)
  }

  // Debounced rendering to prevent excessive processing
  renderTimeout.value = setTimeout(() => {
    renderLatex()
    renderTimeout.value = null
  }, newContent && newContent.length > 5000 ? 500 : 200) // Longer delay for large documents
}, { immediate: true })

// 暴露刷新方法
defineExpose({
  refresh: renderLatex
})

// 组件挂载时强制渲染一次
onMounted(() => {
  if (import.meta.env.DEV) {
    console.log('LatexPreview mounted, forcing initial render')
  }
  renderLatex()
})

// 清理定时器防止内存泄漏
onUnmounted(() => {
  if (renderTimeout.value) {
    clearTimeout(renderTimeout.value)
  }
})
</script>

<style scoped lang="scss">
.latex-preview {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--el-bg-color);
  overflow: hidden;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  border-bottom: 1px solid var(--el-border-color-lighter);
}

.preview-title {
  margin: 0;
  font-size: 14px;
  font-weight: 600;
  color: var(--el-text-color-primary);
}

.preview-content {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
}

.preview-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.preview-error {
  margin: 16px 0;

  ul {
    margin: 8px 0 0 0;
    padding-left: 20px;

    li {
      margin: 4px 0;
    }
  }
}

.preview-rendered {
  font-family: 'Latin Modern Math', 'Times New Roman', serif;
  font-size: calc(14px * v-bind('props.scale'));
  line-height: 1.8;
  color: var(--el-text-color-primary);

  // KaTeX 样式调整
  :deep(.katex) {
    font-size: 1.1em;
  }

  :deep(.katex-display) {
    margin: 1em 0;
    overflow-x: auto;
    overflow-y: hidden;
  }

  // 标题样式
  :deep(h2) {
    font-size: 1.5em;
    font-weight: 600;
    margin: 1em 0 0.5em;
    padding-bottom: 0.3em;
    border-bottom: 1px solid var(--el-border-color-lighter);
  }

  :deep(h3) {
    font-size: 1.3em;
    font-weight: 600;
    margin: 0.8em 0 0.4em;
  }

  :deep(h4) {
    font-size: 1.1em;
    font-weight: 600;
    margin: 0.6em 0 0.3em;
  }

  // 列表样式
  :deep(ul), :deep(ol) {
    padding-left: 2em;
    margin: 0.5em 0;
  }

  :deep(li) {
    margin: 0.3em 0;
  }

  // 段落样式
  :deep(p) {
    margin: 0.5em 0;
    text-align: justify;
  }

  // 错误样式
  :deep(.katex-error) {
    color: var(--el-color-danger);
    border-bottom: 1px dotted var(--el-color-danger);
    cursor: help;
  }

  :deep(.link-error) {
    color: var(--el-color-danger);
    text-decoration: line-through;
  }
}

// 深色模式
.dark {
  .preview-rendered {
    :deep(h2), :deep(h3), :deep(h4) {
      border-color: var(--el-border-color);
    }
  }
}
</style>
