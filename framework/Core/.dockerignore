# Docker ignore file for PaperCrawler::Core
# Reduces build context size and speeds up builds

# Build artifacts
build/
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Test results
test-results/
benchmark-results/
coverage.info
coverage_out/
*.gcda
*.gcno
*.gcov

# Documentation output
docs-output/
html/
latex/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# CMake cache
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt
!cmake/*.cmake

# Temporary files
*.tmp
*.temp
*.log
*.bak

# Node modules (if any tools use it)
node_modules/

# Python (if any Python tools)
__pycache__/
*.py[cod]
*.pyo
.Python

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Documentation drafts
*.md.bak
DRAFT_*.md
